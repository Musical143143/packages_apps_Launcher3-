<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/animation_preview_standard"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_animation_preview_card"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/animation_preview_dot_standard"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_animation_preview_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:padding="12dp"
            android:text="@string/animation_effect_standard"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/animation_preview_enhanced"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_animation_preview_card"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/animation_preview_dot_enhanced"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_animation_preview_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:padding="12dp"
            android:text="@string/animation_effect_enhanced"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
